{
  "name": "bpmn-edit",
  "version": "1.0.1",
  "description": "Open a BPMN file from disk in a browser-based editor, save changes back to disk, and share a live editing session.",
  "type": "module",
  "bin": {
    "bpmn-edit": "bin/bpmn-edit.js"
  },
  "files": [
    "bin/",
    "src/",
    "web/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node bin/bpmn-edit.js",
    "vendor": "node scripts/vendor.js",
    "test": "node --test test/unit/*.test.js",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "bpmn",
    "bpmn-js",
    "editor",
    "collaboration"
  ],
  "author": "Matic Leva",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreadBoy/bpmn-edit.git"
  },
  "homepage": "https://dreadboy.github.io/bpmn-edit/",
  "bugs": {
    "url": "https://github.com/DreadBoy/bpmn-edit/issues"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "open": "^11.0.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "bpmn-js": "^18.31.0"
  }
}

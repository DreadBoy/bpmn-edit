<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:omgc="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Colours" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.40.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_Review">
    <bpmn:participant id="Participant_Team" name="Team" processRef="Process_Review" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Review" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Review">
      <bpmn:lane id="Lane_Author" name="Author">
        <bpmn:flowNodeRef>StartEvent_Draft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Editor" name="Editor">
        <bpmn:flowNodeRef>SubProcess_Fix</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Draft" name="Draft ready">
      <bpmn:outgoing>Flow_ToReview</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Review" name="Review draft">
      <bpmn:incoming>Flow_ToReview</bpmn:incoming>
      <bpmn:outgoing>Flow_ToGateway</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Ok" name="Approved?">
      <bpmn:incoming>Flow_ToGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Done" name="Published">
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:incoming>Flow_Back</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="SubProcess_Fix" name="Fix draft">
      <bpmn:incoming>Flow_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Back</bpmn:outgoing>
      <bpmn:task id="Task_Fix" name="Fix it" />
    </bpmn:subProcess>
    <bpmn:dataObjectReference id="DataObjectReference_Notes" name="Notes" dataObjectRef="DataObject_Notes" />
    <bpmn:dataObject id="DataObject_Notes" />
    <bpmn:sequenceFlow id="Flow_ToReview" sourceRef="StartEvent_Draft" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="Flow_ToGateway" sourceRef="Task_Review" targetRef="Gateway_Ok" />
    <bpmn:sequenceFlow id="Flow_Yes" name="yes" sourceRef="Gateway_Ok" targetRef="EndEvent_Done" />
    <bpmn:sequenceFlow id="Flow_No" name="no" sourceRef="Gateway_Ok" targetRef="SubProcess_Fix" />
    <bpmn:sequenceFlow id="Flow_Back" sourceRef="SubProcess_Fix" targetRef="EndEvent_Done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Review">
      <bpmndi:BPMNShape id="Participant_Team_di" bpmnElement="Participant_Team" isHorizontal="true">
        <dc:Bounds x="120" y="60" width="760" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Author_di" bpmnElement="Lane_Author" isHorizontal="true">
        <dc:Bounds x="150" y="60" width="730" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Editor_di" bpmnElement="Lane_Editor" isHorizontal="true" bc:stroke="#5b176d" bc:fill="#e1bee7" omgc:background-color="#e1bee7" omgc:border-color="#5b176d">
        <dc:Bounds x="150" y="240" width="730" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Draft_di" bpmnElement="StartEvent_Draft">
        <dc:Bounds x="192" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="183" y="175" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Review_di" bpmnElement="Task_Review" bc:stroke="#0d4372" bc:fill="#bbdefb" omgc:background-color="#bbdefb" omgc:border-color="#0d4372">
        <dc:Bounds x="280" y="110" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Ok_di" bpmnElement="Gateway_Ok" isMarkerVisible="true" bc:stroke="#6b3c00" bc:fill="#ffe0b2" omgc:background-color="#ffe0b2" omgc:border-color="#6b3c00">
        <dc:Bounds x="435" y="125" width="50" height="50" />
        <bpmndi:BPMNLabel omgc:color="#6b3c00">
          <dc:Bounds x="433" y="101" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Done_di" bpmnElement="EndEvent_Done">
        <dc:Bounds x="802" y="132" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="796" y="175" width="49" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_Fix_di" bpmnElement="SubProcess_Fix" isExpanded="true">
        <dc:Bounds x="540" y="270" width="220" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Fix_di" bpmnElement="Task_Fix">
        <dc:Bounds x="600" y="300" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectReference_Notes_di" bpmnElement="DataObjectReference_Notes" bc:stroke="#831311" bc:fill="#ffcdd2" omgc:background-color="#ffcdd2" omgc:border-color="#831311">
        <dc:Bounds x="312" y="305" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="316" y="362" width="29" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_ToReview_di" bpmnElement="Flow_ToReview">
        <di:waypoint x="228" y="150" />
        <di:waypoint x="280" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ToGateway_di" bpmnElement="Flow_ToGateway">
        <di:waypoint x="380" y="150" />
        <di:waypoint x="435" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes" bc:stroke="#205022" omgc:border-color="#205022">
        <di:waypoint x="485" y="150" />
        <di:waypoint x="802" y="150" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="635" y="132" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No">
        <di:waypoint x="460" y="175" />
        <di:waypoint x="460" y="340" />
        <di:waypoint x="540" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="469" y="255" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Back_di" bpmnElement="Flow_Back">
        <di:waypoint x="760" y="340" />
        <di:waypoint x="820" y="340" />
        <di:waypoint x="820" y="168" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
